# ---------------------------------------------------------------------------
# Vaultly configuration
# Copy to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
POSTGRES_USER=vaultly
POSTGRES_PASSWORD=vaultly
POSTGRES_DB=vaultly
DATABASE_URL=postgres://vaultly:vaultly@localhost:5432/vaultly?sslmode=disable

# --- Encryption ------------------------------------------------------------
# Master key used to wrap per-secret data keys. Must be exactly 32 bytes,
# base64-encoded. Generate one with:
#
#   openssl rand -base64 32
#
# Losing this key makes every stored secret permanently unrecoverable.
VAULTLY_MASTER_KEY=

# --- Auth ------------------------------------------------------------------
# Signing key for short-lived access tokens. Generate with:
#
#   openssl rand -base64 48
#
JWT_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# --- Server ----------------------------------------------------------------
PORT=8080
ENVIRONMENT=development
LOG_LEVEL=info
# Comma-separated list of browser origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Set to true when running behind a trusted reverse proxy so that
# X-Forwarded-For is honoured for IP allowlisting and rate limiting.
TRUST_PROXY=false

# --- Frontend --------------------------------------------------------------
# Server-side only: where the Next.js server reaches the Go API.
API_BASE_URL=http://localhost:8080
